datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  EDITOR
  AUTHOR
  REVIEWER
  VIEWER
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum LanguageCode {
  en
  ar
}

enum PublishingPlatform {
  HEADLESS_BLOG
  THE_OMNIA_EDIT
  EXTERNAL_PR_MEDIA
  SHOPIFY_STORE
  GHOST_CMS
  WORDPRESS
  WEBHOOK_RSS
}

enum CitationEngine {
  PERPLEXITY
  CHATGPT
  GEMINI
  CLAUDE
  GOOGLE_AI_OVERVIEWS
}

enum BacklinkStatus {
  ACTIVE
  LOST
  BROKEN
  FLAGGED_TOXIC
  DISAVOWED
}

enum OutreachStatus {
  IDENTIFIED
  PITCH_PREPARED
  PITCHED
  IN_NEGOTIATION
  ACCEPTED
  PUBLISHED
  REJECTED
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brands      Brand[]
  users       User[]
  apiKeys     ApiKey[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model Brand {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  slug           String
  domain         String
  currency       String        @default("AED")
  language       LanguageCode  @default(en)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  articles       Article[]
  keywords       Keyword[]
  competitors    Competitor[]
  aiQueries      AiQuery[]
  backlinks      Backlink[]
  outreaches     OutreachTarget[]

  @@unique([organizationId, slug])
  @@map("brands")
}

model User {
  id              String        @id @default(uuid())
  organizationId  String
  email           String        @unique
  passwordHash    String
  fullName        String
  role            UserRole      @default(AUTHOR)
  mfaEnabled      Boolean       @default(false)
  mfaSecret       String?
  isActive        Boolean       @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  articlesAuthored Article[]    @relation("AuthoredArticles")
  revisions       ArticleRevision[]
  auditLogs       AuditLog[]

  @@map("users")
}

model ApiKey {
  id              String        @id @default(uuid())
  organizationId  String
  name            String
  keyPrefix       String
  hashedSecret    String
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime      @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([keyPrefix])
  @@map("api_keys")
}

model Article {
  id                String            @id @default(uuid())
  brandId           String
  authorId          String
  title             String
  slug              String
  language          LanguageCode      @default(en)
  status            ArticleStatus     @default(DRAFT)
  excerpt           String?           @db.Text
  contentHtml       String            @db.Text
  featuredImageUrl  String?
  canonicalUrl      String?
  seoTitle          String?
  seoDescription    String?
  primaryKeyword    String?
  secondaryKeywords String[]          @default([])
  qualityScore      Int               @default(100)
  scheduledAt       DateTime?
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  brand             Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  author            User              @relation("AuthoredArticles", fields: [authorId], references: [id])
  revisions         ArticleRevision[]
  publications      Publication[]

  @@unique([brandId, slug, language])
  @@index([status])
  @@map("articles")
}

model ArticleRevision {
  id          String   @id @default(uuid())
  articleId   String
  userId      String
  title       String
  contentHtml String   @db.Text
  changeLog   String?
  createdAt   DateTime @default(now())

  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@map("article_revisions")
}

model Publication {
  id               String              @id @default(uuid())
  articleId        String
  platform         PublishingPlatform
  externalId       String?
  publishedUrl     String
  status           String              @default("SUCCESS")
  responsePayload  Json?
  publishedAt      DateTime            @default(now())

  article          Article             @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([platform])
  @@map("publications")
}

model Keyword {
  id              String       @id @default(uuid())
  brandId         String
  keyword         String
  country         String       @default("AE")
  language        LanguageCode @default(en)
  searchVolume    Int?
  difficulty      Int?
  currentRank     Int?
  trackedUrl      String?
  intent          String?
  lastCheckedAt   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  brand           Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, keyword, country])
  @@map("keywords")
}

model Competitor {
  id              String       @id @default(uuid())
  brandId         String
  domain          String
  brandName       String
  marketShareEst  Float?
  domainRating    Int?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  brand           Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, domain])
  @@map("competitors")
}

model AiQuery {
  id              String          @id @default(uuid())
  brandId         String
  engine          CitationEngine
  promptQuery     String
  targetUrl       String?
  isActive        Boolean         @default(true)
  lastRunAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  brand           Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  citations       AiCitation[]

  @@map("ai_queries")
}

model AiCitation {
  id              String       @id @default(uuid())
  aiQueryId       String
  isCited         Boolean      @default(false)
  sentimentScore  Float?       // -1.0 to +1.0
  positionRank    Int?
  extractedSnippet String?     @db.Text
  responseRaw     String?      @db.Text
  sampledAt       DateTime     @default(now())

  aiQuery         AiQuery      @relation(fields: [aiQueryId], references: [id], onDelete: Cascade)

  @@index([sampledAt])
  @@map("ai_citations")
}

model Backlink {
  id              String         @id @default(uuid())
  brandId         String
  sourceUrl       String
  targetUrl       String
  anchorText      String?
  isDofollow      Boolean        @default(true)
  domainAuthority Int?
  status          BacklinkStatus @default(ACTIVE)
  firstSeenAt     DateTime       @default(now())
  lastCheckedAt   DateTime       @default(now())

  brand           Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, sourceUrl, targetUrl])
  @@map("backlinks")
}

model OutreachTarget {
  id              String         @id @default(uuid())
  brandId         String
  publicationName String
  contactName     String?
  contactEmail    String?
  domain          String
  authorityScore  Int?
  status          OutreachStatus @default(IDENTIFIED)
  pitchNotes      String?        @db.Text
  lastContactedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  brand           Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("outreach_targets")
}

model AuditLog {
  id              String        @id @default(uuid())
  organizationId  String
  userId          String?
  action          String
  entityType      String
  entityId        String?
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  createdAt       DateTime      @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
