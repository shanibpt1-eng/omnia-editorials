# Omnia Stores Growth Platform Environment Configuration
# Copy this file to .env.local and fill in the values

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Multi-Store Shopify Configuration (OMNIA_COM & OMNIA_AE)
SHOPIFY_COM_SHOP_DOMAIN=omniastores.myshopify.com
SHOPIFY_COM_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_COM_PUBLIC_DOMAIN=omniastores.com

SHOPIFY_AE_SHOP_DOMAIN=omniastores-ae.myshopify.com
SHOPIFY_AE_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_AE_PUBLIC_DOMAIN=omniastores.ae

# Telegram Bot Instant Notifications
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# News & Trend Research Engine (NewsData.io)
NEWSDATA_API_KEY=pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Higgsfield AI Visual & Video Engine
HIGGSFIELD_API_KEY=hf_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI Generation Engine
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Supabase Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Make / Integromat Automation Webhooks
MAKE_WEBHOOK_SECRET=your_hmac_secret_key_here

# Google APIs (Optional for SEO / Traffic Dashboards)
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
GA4_PROPERTY_ID=
