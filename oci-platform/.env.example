# Omnia Content Intelligence (OCI) - Environment Configuration
# Copy to .env in production. NEVER commit secrets to source control.

NODE_ENV=production
OCI_APP_URL=https://intelligence.omniastores.com
OCI_API_URL=https://intelligence.omniastores.com/api/v1

# Security & Encryption (Generate with: openssl rand -hex 32)
# Used for encrypting external API tokens (AES-256-GCM)
OCI_MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://oci_admin:oci_secure_password_2026@postgres:5432/oci_production?schema=public

# Cache & Queues (Redis)
REDIS_URL=redis://:redis_secure_password_2026@redis:6379

# Object Storage (S3 / MinIO)
S3_ENDPOINT=minio:9000
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=oci_minio_admin
S3_SECRET_KEY=oci_minio_secret_password_2026
S3_BUCKET_NAME=oci-media
S3_PUBLIC_URL=https://intelligence.omniastores.com/media

# Outbound Integrations (Set via Admin Vault or environment)
# If left blank, mock adapters will safely execute without external failure
OPENAI_API_KEY=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=omniastores.myshopify.com
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
GA4_PROPERTY_ID=
SERP_API_KEY=

# Ports
API_PORT=3333
WORKER_PORT=3334
WEB_PORT=3001
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
